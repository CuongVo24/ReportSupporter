# ReportSupporter — deployment env contract (W24-H, W25-J).
# Single source of truth; validated by `npm run check:production-config` and the
# /api/ready readiness route. Never commit real secret values.
#
# AI Assistant uses a CLIENT-KEY strategy: users enter their own provider key in
# AI Settings; the browser stores it locally and sends it to /api/ai via the
# x-api-key header per request. Do NOT configure provider API keys server-side.

# ---------------------------------------------------------------------------
# Rate limiter backend — REQUIRED in production (fail-closed).
# Upstash Redis REST. URL and token must be set together; URL must be https.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Dedicated HMAC secret for rate-limit identity fingerprinting — REQUIRED in
# production. Must NOT reuse UPSTASH_REDIS_REST_TOKEN or PDF_TICKET_SECRET.
# Min 24 chars. Version bump lets you rotate without invalidating in-flight
# buckets atomically (rotate: add new version, deploy, remove old version).
RATE_LIMIT_SECRET=
RATE_LIMIT_SECRET_VERSION=v1

# ---------------------------------------------------------------------------
# Trusted proxy mode — REQUIRED in production. Picks the header used to derive
# the client identity for per-user rate limiting. Allowed values:
#   none        (dev only — collapses everyone to one shared "direct" bucket)
#   vercel      (x-forwarded-for, rightmost trusted hop; use on Vercel)
#   forwarded   (RFC 7239 Forwarded header, rightmost trusted hop)
#   cloudflare  (cf-connecting-ip only)
#   x-real-ip   (x-real-ip; use behind an nginx you control)
# Choosing the wrong mode for your host enables IP spoofing OR a shared quota.
# ---------------------------------------------------------------------------
TRUSTED_PROXY_MODE=none

# Number of trusted proxy hops in front of this app — REQUIRED in production
# when TRUSTED_PROXY_MODE is vercel|forwarded. Counts from the RIGHT of the
# XFF/Forwarded chain (the hop closest to your own infra), so an attacker
# cannot spoof extra left-hand entries to move themselves into the trusted slot.
TRUSTED_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# Operator diagnostics — REQUIRED in production. Splits the public /api/ready
# response ({ready} only, no internal detail) from an authenticated operator
# view (causes[], timestamp) gated by the x-operator-token header, compared
# timing-safe. Min 24 chars.
# ---------------------------------------------------------------------------
OPERATOR_DIAGNOSTICS_TOKEN=

# ---------------------------------------------------------------------------
# PDF renderer service — CONDITIONAL (required only when the PDF feature is on,
# i.e. PDF_RENDERER_URL is set). URL + token must be set together.
# PDF_RENDERER_TOKEN must NOT be empty and must NOT be the local default in prod.
# PDF_RENDERER_URL must not carry userinfo/query/fragment; non-https in
# production requires the host to be listed in PDF_RENDERER_ALLOWED_HOSTS.
# ---------------------------------------------------------------------------
PDF_RENDERER_URL=
PDF_RENDERER_TOKEN=
PDF_RENDERER_ALLOWED_HOSTS=
# Renderer capacity envelope (server clamps to 1..4). Raise only with burst/heap evidence.
PDF_MAX_CONCURRENCY=2
# Body/upload admission budget (services/pdf-renderer only) — separate from
# and higher than PDF_MAX_CONCURRENCY so a burst of slow uploads can't starve
# render slots. Defaults to max(8, PDF_MAX_CONCURRENCY*4) if unset.
PDF_BODY_ADMISSION_MAX=
PDF_RENDER_DEADLINE_MS=40000
PDF_GATEWAY_DEADLINE_MS=45000
PDF_CLIENT_DEADLINE_MS=50000
PDF_BODY_READ_TIMEOUT_MS=15000
PDF_SHUTDOWN_GRACE_MS=15000

# ---------------------------------------------------------------------------
# Remote PDF rendering (server-side capability ticket flow) — OFF by default.
# This product has no account/session system, so a public anonymous
# /api/pdf/ticket endpoint cannot create a real authorization boundary by
# itself. Leave PDF_REMOTE_ENABLED=false (Print Preview still works) unless
# this deployment sits behind a trusted upstream identity provider AND
# PDF_TICKET_TRUSTED_ISSUER_MODE=upstream-identity. See
# Design/ContractForAI/Core/break_task/week25_break/w25_fix-all-bugs.md §4.2.
# ---------------------------------------------------------------------------
PDF_REMOTE_ENABLED=false
PDF_TICKET_TRUSTED_ISSUER_MODE=
# Dedicated ticket-signing secret — REQUIRED when PDF_REMOTE_ENABLED=true.
# Must NOT reuse RATE_LIMIT_SECRET or UPSTASH_REDIS_REST_TOKEN. Min 24 chars.
PDF_TICKET_SECRET=
PDF_TICKET_SECRET_VERSION=v1
